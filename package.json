{
  "name": "@local/dsh-composer-clock",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness composer clock with live local time, localized dates, timezone display and click-to-copy timestamps.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "composer-clock",
    "typescript",
    "timezone",
    "clipboard"
  ],
  "homepage": "https://github.com/fxy0715/dsh-composer-clock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxy0715/dsh-composer-clock.git"
  },
  "bugs": {
    "url": "https://github.com/fxy0715/dsh-composer-clock/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/**/*.ts",
    "tsconfig.json"
  ],
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
